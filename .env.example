# Copy to .env.local (never commit real values). See README → "Set up Supabase".

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The "publishable" key (sb_publishable_…). Older projects call it the anon key;
# NEXT_PUBLIC_SUPABASE_ANON_KEY is also accepted.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Canonical site URL, used to build magic-link and OAuth redirect URLs.
# Leave empty locally (http://localhost:3000 is inferred). Set it in production.
NEXT_PUBLIC_SITE_URL=

# OAuth buttons to show on /login. Only list providers you've enabled in Supabase.
# Options: google, github. Empty = email sign-in only.
NEXT_PUBLIC_AUTH_PROVIDERS=

# --- AI assessment (optional, server-only: never prefix these with NEXT_PUBLIC_) ---
# Claude API key, used to grade recorded interviews.
ANTHROPIC_API_KEY=
# Supabase → Project Settings → API → secret key (sb_secret_…, or the legacy service_role key).
# Only used to write AI assessments, which clients aren't allowed to write.
SUPABASE_SECRET_KEY=

# --- Email (optional, server-only). Without it, links are copied by hand. ---
# EMAIL_PROVIDER=resend   (needs RESEND_API_KEY)   or   EMAIL_PROVIDER=smtp   (needs SMTP_*)
EMAIL_PROVIDER=
# The sender, on a domain you've verified with the provider.
EMAIL_FROM="Acme Hiring <hiring@acme.com>"
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# "true" for port 465 (implicit TLS)
SMTP_SECURE=false

# --- Google Calendar (optional, server-only). Without it, invites go out as .ics files. ---
# Google Cloud console → OAuth client (Web). Redirect URI: <NEXT_PUBLIC_SITE_URL>/calendar/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Encrypts stored refresh tokens. 32 random bytes, base64: openssl rand -base64 32
CALENDAR_TOKEN_KEY=
