# Copy to .env.local (never commit real values). See README → "Set up Supabase".

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The "publishable" key (sb_publishable_…). Older projects call it the anon key;
# NEXT_PUBLIC_SUPABASE_ANON_KEY is also accepted.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Canonical site URL, used to build magic-link and OAuth redirect URLs.
# Leave empty locally (http://localhost:3000 is inferred). Set it in production.
NEXT_PUBLIC_SITE_URL=

# OAuth buttons to show on /login. Only list providers you've enabled in Supabase.
# Options: google, github. Empty = email sign-in only.
NEXT_PUBLIC_AUTH_PROVIDERS=
